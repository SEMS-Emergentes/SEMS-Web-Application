# URL base del backend (ASP.NET Core; puerto 8080 por defecto).
# Ya no hay API Gateway: el monolito atiende todas las rutas /api/v1.
VITE_API_BASE_URL=http://localhost:8080

# Modo demo: usa datos simulados sin necesidad de backend.
#   true  -> la app funciona con datos de ejemplo (ideal para ver la UI)
#   false -> consume el backend real (VITE_API_BASE_URL)
VITE_DEMO_MODE=true

# ---------------------------------------------------------------------------
# Las variables VITE_ NO son secretas: Vite las incrusta en el paquete que se
# descarga el navegador. Aqui solo van valores publicos.
#
# La clave secreta de Stripe (sk_...), la del webhook (whsec_...), la de la
# base de datos y JWT_SECRET viven en el backend y NUNCA deben llevar el
# prefijo VITE_. En Vercel estas tres se marcan como Config, no como Secret.
# ---------------------------------------------------------------------------

# Clave PUBLICABLE de Stripe (pk_test_... / pk_live_...). Si se deja vacia,
# la interfaz de alta de tarjeta se oculta.
VITE_STRIPE_PUBLISHABLE_KEY=

# Client ID de Google para el inicio de sesion. Si se deja vacio, el boton de
# Google no se muestra.
VITE_GOOGLE_CLIENT_ID=
